{
  "manifest_version": 3,
  "name": "New Papers",
  "short_name": "New Papers",
  "description": "Shows newly published papers (bioRxiv, medRxiv, PubMed, journals) for your saved search topics every time the browser starts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "New Papers",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.ebi.ac.uk/*",
    "https://eutils.ncbi.nlm.nih.gov/*",
    "https://api.openalex.org/*",
    "https://export.arxiv.org/*"
  ],
  "version": "1.0.0",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "new-papers@remydevbio",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
